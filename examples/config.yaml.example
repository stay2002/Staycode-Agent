# Copy to .staycode/config.yaml for first-time setup.
# Supply the key locally or through OPENAI_API_KEY; never commit a real key.
providers:
  - name: personal-provider
    protocol: openai-compat
    base_url: https://your-provider.example/v1
    model: your-model-name
    api_key: ""

permission_mode: default
mcp_servers: []
